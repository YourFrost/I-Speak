  "sentences": [
    {
      "id": "s1",
      "text": "Ciao!",
      "fr": "Salut !",
      "wordIds": ["w1"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s2",
      "text": "Grazie.",
      "fr": "Merci.",
      "wordIds": ["w2"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s3",
      "text": "Io sono qui.",
      "fr": "Je suis ici.",
      "wordIds": ["w3", "w4", "w5"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s4",
      "text": "Dove sei?",
      "fr": "Où es-tu ?",
      "wordIds": ["w6", "w4"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s5",
      "text": "Dov’è il bagno?",
      "fr": "Où sont les toilettes ?",
      "wordIds": ["w6", "w4", "w7", "w8"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s6",
      "text": "Voglio un caffè.",
      "fr": "Je veux un café.",
      "wordIds": ["w9", "w10", "w11"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s7",
      "text": "Vuoi un caffè?",
      "fr": "Tu veux un café ?",
      "wordIds": ["w9", "w10", "w11"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s8",
      "text": "Voglio mangiare.",
      "fr": "Je veux manger.",
      "wordIds": ["w9", "w12"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s9",
      "text": "Voglio bere l’acqua.",
      "fr": "Je veux boire l’eau.",
      "wordIds": ["w9", "w13", "w7", "w14"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s10",
      "text": "Io non sono stanco.",
      "fr": "Je ne suis pas fatigué.",
      "wordIds": ["w3", "w15", "w4", "w16"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s11",
      "text": "Tu sei stanco?",
      "fr": "Tu es fatigué ?",
      "wordIds": ["w17", "w4", "w16"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s12",
      "text": "Io sto bene.",
      "fr": "Je vais bien.",
      "wordIds": ["w3", "w18", "w19"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s13",
      "text": "Il caffè è buono.",
      "fr": "Le café est bon.",
      "wordIds": ["w7", "w11", "w4", "w20"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s14",
      "text": "La pizza è buona.",
      "fr": "La pizza est bonne.",
      "wordIds": ["w7", "w21", "w4", "w20"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s15",
      "text": "Non voglio il caffè.",
      "fr": "Je ne veux pas le café.",
      "wordIds": ["w15", "w9", "w7", "w11"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s16",
      "text": "Voglio mangiare la pizza.",
      "fr": "Je veux manger la pizza.",
      "wordIds": ["w9", "w12", "w7", "w21"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s17",
      "text": "Dov’è la casa?",
      "fr": "Où est la maison ?",
      "wordIds": ["w6", "w4", "w7", "w22"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s18",
      "text": "La casa è qui.",
      "fr": "La maison est ici.",
      "wordIds": ["w7", "w22", "w4", "w5"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s19",
      "text": "Io sto bene, grazie.",
      "fr": "Je vais bien, merci.",
      "wordIds": ["w3", "w18", "w19", "w2"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s20",
      "text": "Tu non stai bene?",
      "fr": "Tu ne vas pas bien ?",
      "wordIds": ["w17", "w15", "w18", "w19"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s21",
      "text": "Ciao, come stai?",
      "fr": "Salut, comment vas-tu ?",
      "wordIds": ["w1", "w23", "w18"],
      "level": "A1",
      "themes": ["base"]
    },
    {
      "id": "s22",
      "text": "L’acqua è buona.",
      "fr": "L’eau est bonne.",
      "wordIds": ["w7", "w14", "w4", "w20"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s23",
      "text": "Voglio un caffè, per favore.",
      "fr": "Je veux un café, s’il vous plaît.",
      "wordIds": ["w9", "w10", "w11", "w24"],
      "level": "A1",
      "themes": ["restaurant"]
    },
    {
      "id": "s24",
      "text": "Dov’è l’acqua?",
      "fr": "Où est l’eau ?",
      "wordIds": ["w6", "w4", "w7", "w14"],
      "level": "A1",
      "themes": ["voyage"]
    },
    {
      "id": "s25",
      "text": "Vuoi mangiare?",
      "fr": "Tu veux manger ?",
      "wordIds": ["w9", "w12"],
      "level": "A1",
